@page "/orders"
@inject HttpClient Http
@using CampusEats.Client.Models

<h3>Orders</h3>

@if (OrdersList == null)
{
    <p><em>Loading...</em></p>
}
else if (!OrdersList.Any())
{
    <p>No orders found.</p>
}
else
{
    <ul>
        @foreach (var order in OrdersList)
        {
            <li>
                <strong>Order #@order.Id</strong> - Status: @order.Status - Total: $@order.TotalAmount
                <ul>
                    @foreach (var item in order.Items)
                    {
                        <li>@item.MenuItemId: @item.Quantity x $@item.MenuItemPrice</li>
                    }
                </ul>
            </li>
        }
    </ul>
}

@code {
    private List<OrderResponse>? OrdersList;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        OrdersList = await Http.GetFromJsonAsync<List<OrderResponse>>("orders/");
    }
}